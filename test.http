  "location": "Riyadh, Saudi Arabia",
  "about": "Your go-to store for all things plants."
}

### =============================================
### 14. SUBSCRIPTIONS
### =============================================

### Get all subscription plans
GET http://localhost:5050/api/subscriptions

###

### Create a subscription plan
POST http://localhost:5050/api/subscriptions
Content-Type: application/json

{
  "name": "Basic",
  "price": 29,
  "duration": "monthly",
  "features": ["Access to guides", "Forum access"]
}

###

### Update a subscription plan (replace PLAN_ID)
PUT http://localhost:5050/api/subscriptions/PLAN_ID
Content-Type: application/json

{
  "price": 35
}

### =============================================
### 15. BADGES
### =============================================

### Get all badge rules
GET http://localhost:5050/api/badges/rules

###

### Get all experts for badge assignment
GET http://localhost:5050/api/badges/experts

###

### Assign badge to expert (replace EXPERT_ID)
PUT http://localhost:5050/api/badges/experts/EXPERT_ID/assign
Content-Type: application/json

{
  "currentBadge": "Gold",
  "badgeColor": "bg-yellow-400"
}

###

### Remove badge from expert (replace EXPERT_ID)
PUT http://localhost:5050/api/badges/experts/EXPERT_ID/remove

### =============================================
### 16. CHAT (replace TOKEN)
### =============================================

### Chat with plant care chatbot
POST http://localhost:5050/api/chat
Content-Type: application/json
Authorization: Bearer TOKEN

{
  "messages": [
    { "role": "user", "content": "How do I water my plants?" }
  ]
}
