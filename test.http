### =============================================
### 1. REGISTER ALL ROLES
### =============================================

### Register Admin
POST http://localhost:5050/api/auth/register
Content-Type: application/json

{
  "name": "Raghada",
  "email": "Raghada@gmail.com",
  "password": "123456",
  "role": "admin"
}

###

### Register Expert
POST http://localhost:5050/api/auth/register
Content-Type: application/json

{
  "name": "Somaia",
  "email": "Somaia@gmail.com",
  "password": "123456",
  "role": "expert",
  "yearsExperience": 8,
  "bio": "Plant care specialist"
}

###

### Register Gardener
POST http://localhost:5050/api/auth/register
Content-Type: application/json

{
  "name": "Sadeem",
  "email": "Sadeem@gmail.com",
  "password": "123456",
  "role": "gardener"
}

###

### Register Store
POST http://localhost:5050/api/auth/register
Content-Type: application/json

{
  "name": "Anwar",
  "email": "Anwar@gmail.com",
  "password": "123456",
  "role": "store"
}

